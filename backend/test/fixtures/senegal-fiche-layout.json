  "guide": {
    "line": {
      "pattern": "^\\[(?<prefix>[A-Z]+!?)\\]\\s*(?<text>.*)$",
      "style": "puce"
    },
    "prefixes": {
      "N": {
        "variant": "N"
      },
      "N!": {
        "variant": "N"
      },
      "FR": {
        "variant": "FR"
      },
      "FR!": {
        "variant": "FR"
      }
    },
    "call": {
      "pattern": "\\{pt:(?<id>PT-\\d{2})(?<args>[^}]*)\\}",
      "phrases": {
        "PT-01": "E. vérifie que les élèves sont sur la bonne page. Il leur demande de mettre le doigt sur l'image en haut de la page et de l'observer.",
        "PT-02": "E. écoute les réponses sans les corriger.",
        "PT-03": "Pour chaque activité, E. demande la question à toute la classe, les élèves partagent et justifient leurs réponses. E. demande à un élève de donner la réponse. E. corrige.",
        "PT-04": "E. dit de mettre le doigt sur le dessin {img:⟨pictogramme⟩}, puis sur le signe à côté. {img:⟨repère⟩}",
        "PT-05": "E. demande aux élèves de mettre le doigt sur {img:picto-je-retiens}, de regarder l'image et de partager ce qu'ils retiennent. E. reprend l'explication.",
        "PT-06": "E. vérifie que les élèves sont sur la bonne page, le doigt sur l'image {img:picto-je-retiens}.",
        "PT-07": "E. reprend l'explication avec des objets de la classe : ⟨exemple⟩.",
        "PT-08": "Pour chaque activité E. circule, observe le travail des élèves, ensuite demande aux élèves de présenter et justifier leur réponse. E. corrige, au besoin.",
        "PT-09": "E. attire l'attention des élèves sur l'illustration {img:⟨repère⟩}.",
        "PT-11": "Nous allons tracer ensemble les signes X, O et –. Copie ce que je fais au tableau sur ton ardoise.",
        "PT-12": "E. trace X au tableau et circule pour aider. Il répète pour O et –.",
        "PT-13": "E. lit la question puis les trois choix à voix haute. Les élèves répondent à l'oral.",
        "PT-14": "Objectivation : Qu'est-ce qu'on a appris aujourd'hui ?",
        "PT-15": "E. circule et note le travail des élèves, surtout ce qui est mal compris.",
        "PT-16": "E. ne corrige pas collectivement : l'élève doit démontrer seul.",
        "PT-17": "Il illustre au tableau l'exemple ci-contre.",
        "PT-18": "Que voyez-vous sur ce dessin ? Que retenez-vous de ce matin ?",
        "PT-19": "E. fait revenir les élèves à l'image de la situation d'amorce, en haut de la première page.",
        "PT-20": "E. circule et vérifie le matériel des élèves (cahier – stylos – crayons – gommes – ardoises – craies).",
        "PT-21": "Aujourd'hui, vous allez me montrer ce que vous savez déjà faire ⟨domaine⟩.",
        "PT-22": "E. fait sortir les ardoises et trace X · O · – au tableau.",
        "PT-23": "Pour répondre, vous écrivez un seul signe : le X, le O, ou le tiret.",
        "PT-24": "E. présente la situation n° ⟨n⟩ aux élèves. Il fait observer l'image de la situation et lit le contexte.",
        "PT-25": "E. lit les consignes et vérifie la compréhension de ces consignes :",
        "PT-26": "Vous devez répondre à ⟨nombre⟩ questions pour la situation ⟨n⟩. Pour répondre à chaque question, il faut observer attentivement l'image de la situation pour trouver la bonne réponse.",
        "PT-27": "Pour chaque question, E. relit la question à toute la classe, fixe et chronomètre le temps de résolution (3 min par question). Les élèves partagent et justifient leurs réponses. E. circule entre les rangées, explique et débloque les élèves en difficulté.",
        "PT-28": "Après 3 min, E. demande aux élèves de mettre le doigt sur {img:⟨repère⟩}.",
        "PT-29": "E. fait corriger une à une toutes les questions et demande ce que les élèves retiennent. E. reprend l'explication en mettant l'accent sur les difficultés rencontrées.",
        "PT-30": "E. lit le contexte et les consignes. E. vérifie la compréhension de la situation. E. demande aux élèves de faire le travail. Il fixe et chronomètre le temps pour le travail des élèves.",
        "PT-31": "E. circule, observe le travail des élèves, les aide au besoin. E. remplit le tableau de compilation pour chaque question.",
        "PT-32": "E. demande aux élèves de présenter et justifier leurs résultats. E. reprend la correction, explique la démarche en mettant l'accent sur les difficultés rencontrées.",
        "PT-33": "Pour chaque question, le maître attire l'attention sur les ressources nécessaires à mobiliser et la technique d'intégration de ces ressources pour arriver au résultat."
      },
      "markerSlot": "repère"
    },
    "inline": {
      "pattern": "\\{img:(?<name>[^}]+)\\}",
      "assets": {
        "picto-je-fais": {
          "relPath": "assets/picto-je-fais.svg",
          "role": "picto-section"
        },
        "picto-nous-faisons": {
          "relPath": "assets/picto-nous-faisons.svg",
          "role": "picto-section"
        },
        "picto-je-retiens": {
          "relPath": "assets/picto-je-retiens.svg",
          "role": "picto-section"
        },
        "picto-tu-fais": {
          "relPath": "assets/picto-tu-fais.svg",
          "role": "picto-section"
        },
        "picto-materiel": {
          "relPath": "assets/picto-materiel.svg",
          "role": "picto-materiel"
        },
        "rep-etoile": {
          "relPath": "assets/rep-etoile.svg",
          "role": "marqueur"
        },
        "rep-triangle": {
          "relPath": "assets/rep-triangle.svg",
          "role": "marqueur"
        },
        "rep-carre": {
          "relPath": "assets/rep-carre.svg",
          "role": "marqueur"
        },
        "rep-cercle": {
          "relPath": "assets/rep-cercle.svg",
          "role": "marqueur"
        }
      }
    },
    "image": {
      "pattern": "^(?<marker>[★▲■●])?\\s*\\[IMAGE : (?<name>[^\\]\\s]+)[^\\]]*\\]",
      "roles": [
        {
          "match": "-amorce$",
          "role": "amorce"
        },
        {
          "match": "je-retiens$",
          "role": "notion"
        },
        {
          "match": "^(tableau-|modelage$)",
          "role": "scene"
        }
      ],
      "defaultRole": "bande",
      "mark": "answer"
    },
    "markers": {
      "★": "rep-etoile",
      "▲": "rep-triangle",
      "■": "rep-carre",
      "●": "rep-cercle"
    },
    "trailing": {
      "pattern": "\\s(?<tail>\\([^()]+\\))$",
      "style": "parenthese",
      "translate": false,
      "prefixes": [
        "FR",
        "FR!"
      ]
    }
  }
}