{
  "templates": [
    {
      "name": "fiche",
      "match": {
        "section": "^Fiche — Leçon",
        "root": true
      },
      "blocks": [
        {
          "kind": "table",
          "rows": [
            [
              {
                "style": "bandeau-semaine",
                "blocks": [
                  {
                    "kind": "line",
                    "runs": [
                      {
                        "text": "Semaine {{covered.position|ceil-div:5}}"
                      }
                    ]
                  }
                ]
              },
              {
                "style": "bandeau-lecon",
                "blocks": [
                  {
                    "kind": "line",
                    "runs": [
                      {
                        "text": "Leçon {{covered.position}}"
                      }
                    ]
                  }
                ]
              },
              {
                "style": "bandeau-jour",
                "blocks": [
                  {
                    "kind": "line",
                    "runs": [
                      {
                        "text": "jour {{covered.position|mod-1based:5}}"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        {
          "kind": "table",
          "rows": [
            [
              {
                "style": "bandeau-os",
                "blocks": [
                  {
                    "kind": "line",
                    "runs": [
                      {
                        "text": "OS – {{covered.name}}."
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        {
          "kind": "table",
          "rows": [
            [
              {
                "style": "bandeau-materiel",
                "blocks": [
                  {
                    "kind": "line",
                    "runs": [
                      {
                        "image": {
                          "role": "picto-materiel",
                          "asset": {
                            "relPath": "assets/picto-materiel.svg"
                          }
                        }
                      },
                      {
                        "text": "  {{section.guide|match:^Case MATÉRIEL : (.+)$}}"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        {
          "kind": "children"
        }
      ]
    },
    {
