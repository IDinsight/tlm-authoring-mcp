/node_modules
/dist
# Backend package (its own tree under backend/) — ignore install + build output.
backend/node_modules
backend/dist
*.json
.DS_Store
!knowledge_graph.json
!example_domains.json
!package.json
!package-lock.json

# The blanket `*.json` above swallowed the plugin's own manifest, so the plugin
# on GitHub had no plugin.json and could not be installed at all. Negate the
# plugin's files by EXACT PATH — never by name — because a repo-root Firebase
# service-account key is relying on that same blanket rule to stay out.
!/.claude-plugin/marketplace.json
!/plugin/.claude-plugin/plugin.json
!/plugin/.mcp.json
!tsconfig.json
!firebase.json
# Committed test fixtures (golden snapshots) live under __fixtures__ dirs.
!backend/src/adapters/__fixtures__/*.json
# The pinned shape of the committed fixture graphs — the review gate a fixture
# refresh has to pass. By exact path, per the rule above.
!/backend/test/fixtures/SHAPE.json

# Frontend explorer (Vite/React) — its own package tree. Track its config JSON
# (rescued from the blanket *.json ignore above), but not its build artefacts.
!frontend/**/*.json
frontend/explorer/node_modules
frontend/explorer/dist

# Firebase CLI deploy cache
/.firebase
